{
  "name": "gentle-cowork",
  "version": "1.2.1",
  "description": "Orchestration extension for Pi/gentle-shell: structured multi-role delegation that respects ODD.",
  "type": "module",
  "main": "src/gentle-cowork.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dogfood:worker": "tsx scripts/dogfood-worker.ts",
    "dogfood:master": "tsx scripts/dogfood-master.ts",
    "dogfood:run": "tsx scripts/dogfood-native.ts run --timeout 180",
    "worker:remote": "tsx scripts/launch-remote-worker.ts",
    "worker:container": "tsx scripts/run-remote-worker.ts"
  },
  "keywords": [
    "pi",
    "gentle-shell",
    "gentle-ai",
    "extension",
    "orchestration",
    "odd",
    "pi-package"
  ],
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "dependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node-forge": "^1.3.14",
    "blessed": "^0.1.81",
    "node-forge": "^1.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipproyectosysoluciones/gentle-cowork.git"
  },
  "bugs": {
    "url": "https://github.com/ipproyectosysoluciones/gentle-cowork/issues"
  },
  "homepage": "https://github.com/ipproyectosysoluciones/gentle-cowork#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.1",
  "pi": {
    "extensions": [
      "./src/gentle-cowork.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  }
}
